{
  "version": "2.0.0",
  "tasks": [
    {
      // Declared explicitly rather than relying on npm task auto-detection,
      // which launch.json's preLaunchTask would otherwise depend on.
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "npm: test",
      "type": "npm",
      "script": "test",
      "group": "test",
      "problemMatcher": ["$tsc"]
    }
  ]
}
